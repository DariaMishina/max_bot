[Unit]
Description=xTunnel for Tarot Sphere API gateway (port 8084)
Wants=network-online.target nginx.service
After=network-online.target nginx.service app-api.service max-bot.service
StartLimitIntervalSec=0

[Service]
# license.env must contain XTUNNEL_LICENSE and have permissions 0600.
EnvironmentFile=/home/dariamishina/.local/share/xtunnel/license.env
Type=simple
User=dariamishina
WorkingDirectory=/home/dariamishina/.local/share/xtunnel
ExecStart=/home/dariamishina/.local/share/xtunnel/xtunnel http 8084 --local 127.0.0.1:8084 --monitor false --output-mode plain --quiet --log-format json --inspect off --backend-timeout 120 --license ${XTUNNEL_LICENSE}
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
