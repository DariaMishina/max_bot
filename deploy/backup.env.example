# Install as /etc/max-bot-backup/backup.env with owner root:root and mode 0600.
# Do not commit real credentials or the age private identity.

BACKUP_S3_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru
BACKUP_S3_BUCKET=replace-with-private-bucket-name
BACKUP_S3_PREFIX=daily
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
BACKUP_WORK_DIR=/var/lib/max-bot-backup

AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_DEFAULT_REGION=ru-msk

# Optional monitoring endpoints. A missing success heartbeat should alert after
# 26 hours. The failure endpoint is called immediately after a failed run.
BACKUP_SUCCESS_HEARTBEAT_URL=
BACKUP_FAILURE_HEARTBEAT_URL=
