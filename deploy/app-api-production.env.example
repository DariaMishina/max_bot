# Install as /etc/tarot-sphere/app-api-production.env with root:root 0600.
# Every secret and database credential must differ from staging.
APP_ENVIRONMENT=production
APP_API_PORT=8093
APP_API_PUBLIC_URL=https://api.example/
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app_bot_prod_db
APP_DB_USER=app_bot_prod_user
APP_DB_PASSWORD=<unique-production-password-at-least-16-characters>
APP_JWT_SECRET=<unique-production-jwt-secret-at-least-32-characters>
APP_ALLOW_GUEST_AUTH=false
APP_ALLOW_UNPAID_TEST_CONTACT=false
APP_API_IP_REQUESTS_PER_MINUTE=120
APP_AUTH_IP_REQUESTS_PER_15_MINUTES=30
APP_API_USER_REQUESTS_PER_MINUTE=60
APP_DIVINATION_USER_REQUESTS_PER_HOUR=20
APP_DEEPSEEK_DAILY_REQUEST_LIMIT=500
APP_DEEPSEEK_CONCURRENT_REQUESTS=2
APP_EMAIL_SMTP_HOST=smtp.yandex.com
APP_EMAIL_SMTP_PORT=465
APP_EMAIL_SMTP_USER=<production-email>
APP_EMAIL_SMTP_PASSWORD=<production-email-password>
APP_EMAIL_FROM=<production-email>
APP_EMAIL_SMTP_SSL=true
APP_VK_CLIENT_ID=54803401
APP_RUSTORE_CONSOLE_APP_ID=2063751721
APP_RUSTORE_KEY_ID=<production-public-api-key-id>
APP_RUSTORE_PRIVATE_KEY=<production-private-key-base64>
APP_RUSTORE_CALLBACK_KEY=<production-callback-key-base64>
APP_RUSTORE_API_BASE_URL=https://public-api-m.rustore.ru
APP_RUSTORE_SANDBOX=false
