[Unit]
Description=Tarot Sphere App API (%i)
After=network.target postgresql.service

[Service]
Type=simple
User=dariamishina
WorkingDirectory=/home/dariamishina/max_bot
EnvironmentFile=/etc/tarot-sphere/app-api-%i.env
# Only the validator reads the root-only env file directly. The API itself stays
# under User=dariamishina and receives values through EnvironmentFile.
ExecStartPre=+/home/dariamishina/max_bot/venv/bin/python scripts/check_app_environment.py --env-file /etc/tarot-sphere/app-api-%i.env --expected %i
ExecStart=/home/dariamishina/max_bot/venv/bin/python app_api_server.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
