# Install as /etc/tarot-sphere/app-api-staging.env with root:root 0600.
APP_ENVIRONMENT=staging
APP_API_PORT=8083
APP_API_PUBLIC_URL=https://01a0ba9c-b091-79dc-9a97-07e3b1eba847.tunnel4.com/
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app_bot_db
APP_DB_USER=app_bot_user
APP_DB_PASSWORD=<existing-staging-password>
APP_JWT_SECRET=<existing-staging-jwt-secret>
APP_ALLOW_GUEST_AUTH=false
APP_ALLOW_UNPAID_TEST_CONTACT=true
APP_API_IP_REQUESTS_PER_MINUTE=120
APP_AUTH_IP_REQUESTS_PER_15_MINUTES=30
APP_API_USER_REQUESTS_PER_MINUTE=60
APP_DIVINATION_USER_REQUESTS_PER_HOUR=20
APP_DEEPSEEK_DAILY_REQUEST_LIMIT=500
APP_DEEPSEEK_CONCURRENT_REQUESTS=2
APP_EMAIL_SMTP_HOST=smtp.yandex.com
APP_EMAIL_SMTP_PORT=465
APP_EMAIL_SMTP_USER=<staging-email>
APP_EMAIL_SMTP_PASSWORD=<staging-email-password>
APP_EMAIL_FROM=<staging-email>
APP_EMAIL_SMTP_SSL=true
APP_VK_CLIENT_ID=54803401
APP_RUSTORE_CONSOLE_APP_ID=2063751721
APP_RUSTORE_KEY_ID=<staging-public-api-key-id>
APP_RUSTORE_PRIVATE_KEY=<staging-private-key-base64>
APP_RUSTORE_CALLBACK_KEY=<staging-callback-key-base64>
APP_RUSTORE_API_BASE_URL=https://public-api-m.rustore.ru
APP_RUSTORE_SANDBOX=true
