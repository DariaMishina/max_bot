# ============================================================
# Max-бот «Гадание AI» — переменные окружения
# Скопируйте в .env и заполните значения
# ============================================================

# --- Обязательные ---

# Токен бота Max (получить у @MasterBot в Max: https://max.ru/masterbot)
BOT_TOKEN=your_max_bot_token_here

# OpenAI API Key (для толкования гаданий через ChatGPT)
API_KEY=sk-proj-xxx

# PostgreSQL (с Mac — IP сервера; на VM max_bot: DB_HOST=localhost)
DB_HOST=46.16.36.243
DB_PORT=5432
DB_NAME=max_bot_db
DB_USER=max_bot_user
DB_PASSWORD=your_password

# --- Опциональные ---

# ЮKassa (без них бот работает, но оплата недоступна)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Куда пересылать обратную связь (/feedback) — user_id админа в Max
ADMIN_CHAT_ID=

# Яндекс Метрика Measurement Protocol (для кампании Директ → бот напрямую)
# Счётчик: создать на https://metrika.yandex.ru, указать сайт max.ru
# Токен: получить в настройках счётчика
METRIKA_MP_COUNTER_ID=
METRIKA_MP_TOKEN=

# Личная консультация с тарологом (опциональная услуга)
# TAROLOGIST_PROFILE_URL — ссылка на профиль таролога в MAX
# (формат https://max.ru/<username> или https://max.ru/u/<token>)
TAROLOGIST_NAME=Диана
TAROLOGIST_PROFILE_URL=
TAROLOGIST_WORK_HOURS=10:00–22:00

# --- Тестовый режим ---

# TEST_MODE=true — используется BOT_TOKEN_TEST, суффикс _test для таблиц БД
# TEST_MODE=false (по умолчанию)
TEST_MODE=false
BOT_TOKEN_TEST=

# Включать только после применения broadcast-миграций и smoke-проверки job'ов
PERSONALIZED_BROADCASTS=false

# --- API Android-приложения (отдельный процесс app_api_server.py) ---

# Публичный HTTPS-адрес API (xTunnel). Пользователи не видят — только для клиента и webhook.
APP_API_PUBLIC_URL=https://your-id.tunnel4.com

# Лицензия xTunnel — только на сервере, не коммитить
XTUNNEL_LICENSE=

# БД приложения (отдельно от max_bot_db)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app_bot_db
APP_DB_USER=app_bot_user
APP_DB_PASSWORD=

# Порт локального API на VM (xTunnel проксирует сюда)
APP_API_PORT=8083

# JWT для гостевых токенов
APP_JWT_SECRET=
